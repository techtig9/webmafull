# ============================================================
# Webma production environment
# Never commit real secrets. Configure these in your deployment
# provider and keep service-role/provider secrets server-side.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — Webma uses a fallback chain for lightweight tasks
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Complex generation provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=8192

# AI image generation (distinct pipeline — see src/lib/image-gen.ts)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Billing / Paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_BUSINESS_MONTH=
PADDLE_PRICE_BUSINESS_YEAR=

# Deployment
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# Optional per-user deployment OAuth
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
NETLIFY_OAUTH_CLIENT_ID=
NETLIFY_OAUTH_CLIENT_SECRET=
# 64 hex characters / 32 bytes
DEPLOY_TOKEN_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional — falls back to a built-in default if unset, but a
# real deployment should set its own so the daily visitor hash salt isn't
# a value visible in this public repo)
ANALYTICS_HASH_SALT=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
